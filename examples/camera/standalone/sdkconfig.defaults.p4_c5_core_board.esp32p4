CONFIG_PARTITION_TABLE_CUSTOM=y

#
# Chip revision
#
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_0=y

CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG_ENABLED=y

#
# Slave Flasher
#
CONFIG_SLAVE_FLASHER_ENABLE=y
# Match the network_adapter C5 layout (table @0x8000, first app slot @0x10000);
# the component defaults (0xC000/0x20000) target a different layout and would
# brick the C5 boot chain.
CONFIG_SLAVE_PARTITION_TABLE_ADDRESS=0x8000
CONFIG_SLAVE_APPLICATION_ADDRESS=0x10000
CONFIG_SLAVE_UART_RX_PIN=45
CONFIG_SLAVE_UART_TX_PIN=46
CONFIG_SLAVE_GPIO0_TRIGGER_PIN=47

#
# Select Hosted Board
#
CONFIG_SLAVE_IDF_TARGET_ESP32C5=y
CONFIG_ESP_HOSTED_P4_C5_CORE_BOARD=y

#
# 16 MB flash + slave partition for in-system C6/C5 flashing (slave_flasher)
#
# CONFIG_ESPTOOLPY_FLASHSIZE_8MB is not set
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.16mb.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.16mb.csv"
