#
# rmaker_split_camera C5 build config for the ESP32-P4 + ESP32-C5 core board.
# Layered on top of sdkconfig.defaults + sdkconfig.defaults.esp32c5.
#
# Build with:
#   idf.py -D 'SDKCONFIG_DEFAULTS=sdkconfig.defaults;sdkconfig.defaults.esp32c5;sdkconfig.defaults.p4_c5_core_board.esp32c5' set-target esp32c5 build
#
# Pairs with the KVS SDK's examples/streaming_only built with
# sdkconfig.defaults.p4_c5_core_board.esp32p4. Both halves select the same
# board symbol; esp_hosted resolves it to each side's own GPIO map, so the SDIO
# lines and the host-wake GPIO cannot drift apart.
#
CONFIG_ESP_HOSTED_P4_C5_CORE_BOARD=y
